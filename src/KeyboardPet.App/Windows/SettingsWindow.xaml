<Window x:Class="KeyboardPet.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:KeyboardPet.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="Keyboard Pet 설정"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="860" Height="620"
        MinWidth="780" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="White"
        FontFamily="Segoe UI, Malgun Gothic"
        FontSize="13">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6C757D" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C0392B" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 테마(Bootstrap.xaml)의 암시적 스타일을 유지하면서 간격만 조정 -->
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,5,0,5" />
        </Style>

        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="Margin" Value="0,8,0,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,4,0,4" />
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <Style x:Key="RowValue" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource BsSmallButton}">
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>

        <Style x:Key="SmallDangerButton" TargetType="Button" BasedOn="{StaticResource BsSmallDangerButton}">
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>

        <!-- "세트 'x'의 설정 편집 중" 안내 띠 (alert-primary) -->
        <Style x:Key="ProfileBanner" TargetType="Border">
            <Setter Property="Background" Value="#CFE2FF" />
            <Setter Property="BorderBrush" Value="#9EC5FE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <!-- 애니메이션·키 매핑 탭 상단: 편집 대상 세트 안내와 사용할 세트 선택 -->
        <DataTemplate x:Key="ProfileBannerTemplate" DataType="{x:Type vm:SettingsViewModel}">
            <Border Style="{StaticResource ProfileBanner}">
                <DockPanel>
                    <ComboBox DockPanel.Dock="Right" Width="180" Margin="12,0,0,0" VerticalAlignment="Center"
                              ItemsSource="{Binding AvailableSetNames}" SelectedItem="{Binding DefaultFrameSet}"
                              ToolTip="사용할 세트. 이 탭의 설정은 고른 세트에 저장됩니다" />
                    <TextBlock Text="{Binding ProfileTargetText}" Foreground="#084298" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- card 형태의 목록 행 -->
        <Style x:Key="ItemCard" TargetType="Border">
            <Setter Property="BorderBrush" Value="#DEE2E6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Background" Value="White" />
        </Style>

        <!-- 효과 카드: 효과 탭(세트 효과, 적용 프레임 선택 포함)과 키 매핑 규칙의 효과 목록이 함께 쓴다 -->
        <DataTemplate x:Key="EffectItemTemplate" DataType="{x:Type vm:EffectItemViewModel}">
            <Border BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,6" Background="#F8F9FA">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" ItemsSource="{Binding KindChoices}" SelectedItem="{Binding SelectedKind}"
                                  DisplayMemberPath="Label" ToolTip="{Binding KindDescription}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="강도" VerticalAlignment="Center" Margin="12,0,6,0" />
                        <Slider Grid.Column="2" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" MinWidth="90"
                                Value="{Binding Strength}" VerticalAlignment="Center" ToolTip="움직임의 크기 (0~100%)" />
                        <TextBlock Grid.Column="3" Text="{Binding StrengthText}" VerticalAlignment="Center" TextAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="속도" VerticalAlignment="Center" Margin="12,0,6,0" />
                        <!-- 왼쪽이 빠름: 한 번 움직이는 데 걸리는 시간(ms) -->
                        <Slider Grid.Column="5" Minimum="100" Maximum="5000" TickFrequency="50" IsSnapToTickEnabled="True" MinWidth="90"
                                Value="{Binding PeriodMs}" VerticalAlignment="Center" ToolTip="한 번 움직이는 데 걸리는 시간. 왼쪽일수록 빠릅니다" />
                        <TextBlock Grid.Column="6" Text="{Binding PeriodText}" VerticalAlignment="Center" TextAlignment="Right" />
                        <Button Grid.Column="7" Content="삭제" Style="{StaticResource SmallDangerButton}" Margin="10,0,0,0"
                                Command="{Binding RemoveCommand}" />
                    </Grid>

                    <!-- 적용 프레임 (세트 효과만) -->
                    <StackPanel Margin="0,6,0,0" Visibility="{Binding ShowFrameSelection, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="적용 프레임:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <CheckBox Content="모든 프레임" IsChecked="{Binding AllFrames}" VerticalAlignment="Center" Margin="0" />
                            <TextBlock Text="{Binding FramesSummary}" Foreground="#6C757D" FontSize="11.5" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding FrameToggles}" Margin="0,4,0,0">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AllFrames}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FrameToggleViewModel}">
                                    <ToggleButton IsChecked="{Binding IsChecked}" Margin="0,0,4,4" Padding="3" Background="White"
                                                  BorderBrush="#CED4DA" ToolTip="이 프레임이 보일 때 효과를 적용합니다">
                                        <StackPanel>
                                            <Border Width="40" Height="40">
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                            </Border>
                                            <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontSize="11" />
                                        </StackPanel>
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="2" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="Box" Property="BorderBrush" Value="#0D6EFD" />
                                                                    <Setter TargetName="Box" Property="Background" Value="#CFE2FF" />
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Box" Property="BorderBrush" Value="#86B7FE" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <TabControl Margin="8">

        <!-- ───────── 일반 ───────── -->
        <TabItem Header="일반">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12">
                    <GroupBox Header="창">
                        <StackPanel>
                            <CheckBox Content="항상 위에 표시" IsChecked="{Binding IsTopmost}" />
                            <CheckBox Content="타수 표시" IsChecked="{Binding ShowCounter}" />
                            <CheckBox Content="클릭 통과" IsChecked="{Binding ClickThrough}" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="클릭 통과를 켜면 펫 창을 클릭하거나 드래그할 수 없습니다. 메뉴는 트레이 아이콘에서 열 수 있습니다." />

                            <Grid Style="{StaticResource Row}" Margin="0,10,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="배율" />
                                <Slider Grid.Column="1" Minimum="0.25" Maximum="4" TickFrequency="0.25" IsSnapToTickEnabled="True"
                                        Value="{Binding Scale}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Style="{StaticResource RowValue}" Text="{Binding Scale, StringFormat={}{0:0.00}×}" />
                            </Grid>

                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="불투명도" />
                                <Slider Grid.Column="1" Minimum="0.1" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                        Value="{Binding Opacity}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Style="{StaticResource RowValue}" Text="{Binding Opacity, StringFormat={}{0:P0}}" />
                            </Grid>

                            <Button Content="위치 초기화 (작업 영역 우하단으로)" Command="{Binding ResetPositionCommand}"
                                    HorizontalAlignment="Left" Margin="0,8,0,0" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="입력">
                        <StackPanel>
                            <CheckBox Content="키를 길게 누를 때의 반복 입력도 타수로 계산" IsChecked="{Binding CountAutoRepeat}" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="시작">
                        <StackPanel>
                            <CheckBox Content="Windows 로그인 시 자동 실행" IsChecked="{Binding StartWithWindows}" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="현재 사용자 계정의 시작 프로그램(레지스트리 Run)에 등록합니다. 실행 파일을 옮기면 다시 켜 주세요." />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ───────── 이미지 세트 ───────── -->
        <TabItem Header="이미지 세트">
            <!-- 탭 전체가 드롭 영역: 폴더 → 세트 추가, 이미지 파일 → 새 세트 생성(앱 폴더로 복사). 카드 위는 그 세트에 추가 -->
            <Grid Margin="12" Background="Transparent" AllowDrop="True"
                  DragOver="SetsArea_DragOver" Drop="SetsArea_Drop">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                    <Button DockPanel.Dock="Left" Content="폴더 추가..." Style="{StaticResource BsPrimaryButton}" Command="{Binding AddFrameSetCommand}"
                            ToolTip="이미지가 들어 있는 기존 폴더를 세트로 추가합니다" />
                    <Button DockPanel.Dock="Left" Content="새 세트" Command="{Binding AddEmptySetCommand}" Margin="8,0,0,0"
                            ToolTip="빈 세트를 만듭니다. 앱 폴더에 세트 폴더가 생기며, 카드에 이미지를 끌어다 놓으면 그 폴더로 복사됩니다" />
                    <ComboBox DockPanel.Dock="Right" Width="180" ItemsSource="{Binding AvailableSetNames}"
                              SelectedItem="{Binding DefaultFrameSet}" VerticalAlignment="Center"
                              ToolTip="펫으로 표시할 세트. 애니메이션·키 매핑 설정은 세트마다 따로 저장됩니다" />
                    <TextBlock DockPanel.Dock="Right" Text="사용할 세트:" VerticalAlignment="Center" Margin="0,0,8,0" />
                </DockPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FrameSets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FrameSetItemViewModel}">
                                <Border Style="{StaticResource ItemCard}" AllowDrop="True"
                                        DragOver="SetCard_DragOver" Drop="SetCard_Drop">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding Name}" ToolTip="세트 이름 (애니메이션·키 매핑 설정이 이 이름에 저장됨)" Margin="0,0,6,0" />
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Folder}" ToolTip="이미지가 들어 있는 폴더" />
                                        <Button Grid.Row="0" Grid.Column="2" Content="찾아보기..." Style="{StaticResource SmallButton}"
                                                Command="{Binding Owner.BrowseFrameSetFolderCommand}" CommandParameter="{Binding}" />
                                        <Button Grid.Row="0" Grid.Column="3" Content="삭제" Style="{StaticResource SmallDangerButton}"
                                                Command="{Binding Owner.RemoveFrameSetCommand}" CommandParameter="{Binding}" />

                                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,6,0,0">
                                            <!-- 프레임 타일: 드래그로 순서 변경, × 로 제외. 이벤트는 코드비하인드(SettingsWindow.xaml.cs)에서 처리 -->
                                            <ItemsControl ItemsSource="{Binding Frames}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:FrameEntryViewModel}">
                                                        <Border Width="58" Height="66" Margin="0,0,6,6" BorderThickness="1" CornerRadius="6"
                                                                AllowDrop="True" Cursor="SizeAll" ToolTip="{Binding FileName}"
                                                                PreviewMouseLeftButtonDown="FrameTile_PreviewMouseLeftButtonDown"
                                                                PreviewMouseLeftButtonUp="FrameTile_PreviewMouseLeftButtonUp"
                                                                PreviewMouseMove="FrameTile_PreviewMouseMove"
                                                                DragOver="FrameTile_DragOver"
                                                                Drop="FrameTile_Drop">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderBrush" Value="#DEE2E6" />
                                                                    <Setter Property="Background" Value="#F8F9FA" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                                            <Setter Property="BorderBrush" Value="#DC3545" />
                                                                            <Setter Property="Background" Value="#F8D7DA" />
                                                                        </DataTrigger>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="BorderBrush" Value="#86B7FE" />
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Grid>
                                                                <!-- 애니메이션에서 뺀(키 전용) 프레임은 흐리게 표시 -->
                                                                <Image Source="{Binding Thumbnail}" Width="44" Height="44" Margin="0,3,0,0"
                                                                       VerticalAlignment="Top" Stretch="Uniform">
                                                                    <Image.Style>
                                                                        <Style TargetType="Image">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding InAnimation}" Value="False">
                                                                                    <Setter Property="Opacity" Value="0.35" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Image.Style>
                                                                </Image>
                                                                <TextBlock Text="없음" Foreground="#C0392B" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Visibility="{Binding IsMissing, Converter={StaticResource BoolToVis}}" />
                                                                <TextBlock Text="{Binding Number}" FontSize="10.5" Foreground="#555"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                                                                <CheckBox IsChecked="{Binding InAnimation}" Focusable="False" Margin="2,2,0,0"
                                                                          HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                          ToolTip="루프 애니메이션에 포함. 해제하면 키 매핑의 프레임 선택에서만 쓰입니다(키 전용)." />
                                                                <Button Content="×" Style="{StaticResource BsCloseButton}" Focusable="False"
                                                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"
                                                                        ToolTip="이 프레임 제외"
                                                                        Command="{Binding Owner.RemoveFrameCommand}" CommandParameter="{Binding}" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" FontSize="11.5">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#666" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                    <Setter Property="Foreground" Value="#C0392B" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="· 순서 편집됨" Foreground="#0D6EFD" FontSize="11.5" Margin="6,0,0,0" VerticalAlignment="Center"
                                                           Visibility="{Binding HasCustomFrames, Converter={StaticResource BoolToVis}}" />
                                                <Button Content="폴더 순서로 되돌리기" Style="{StaticResource SmallButton}" Margin="10,0,0,0" FontSize="11.5"
                                                        Command="{Binding ResetFramesCommand}"
                                                        Visibility="{Binding HasCustomFrames, Converter={StaticResource BoolToVis}}" />

                                                <TextBlock Text="무입력 복귀 프레임:" FontSize="11.5" Margin="16,0,6,0" VerticalAlignment="Center" Foreground="#495057" />
                                                <ComboBox Width="190" MinHeight="26" FontSize="12" ItemsSource="{Binding IdleFrameChoices}" SelectedItem="{Binding SelectedIdleFrame}"
                                                          ToolTip="타수 기반·타이핑 속도 연동 모드에서 입력이 멈추면 보여줄 프레임입니다. 시작 직후에도 이 프레임으로 대기하며, 키 전용 프레임도 고를 수 있습니다.">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:IdleFrameChoice}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Image Source="{Binding Entry.Thumbnail}" Width="18" Height="18" Margin="0,0,5,0" Stretch="Uniform" />
                                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="2">
                    <!-- 드롭 안내: 세트가 없을 때 크게, 있을 때는 한 줄로 -->
                    <Border BorderBrush="#86B7FE" BorderThickness="1.5" CornerRadius="8" Background="#F8FBFF" Padding="16" Margin="0,0,0,10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FrameSets.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock TextAlignment="Center" Foreground="#0D6EFD" FontSize="13"
                                   Text="이미지 파일이나 폴더를 이 탭에 끌어다 놓으면 세트가 만들어집니다.&#10;폴더는 그대로 세트가 되고, 파일들은 앱 폴더에 복사되어 새 세트가 됩니다." />
                    </Border>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#0D6EFD" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding BuiltInSummary}" Foreground="#444" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="폴더 안의 PNG/JPG/BMP/GIF 파일이 파일명 순서대로 프레임이 됩니다(GIF는 프레임 단위로 풀립니다). 이미지 파일이나 폴더를 탭에 끌어다 놓으면 세트가 추가되고, 세트 카드 위에 놓으면 그 세트에 프레임이 추가됩니다. 타일을 드래그해 순서를 바꾸고 × 로 제외할 수 있으며, 타일의 체크를 풀면 그 프레임은 루프 애니메이션에서 빠지고 키 매핑의 프레임 선택에서만 쓰입니다(키 전용). '무입력 복귀 프레임'은 타이핑이 멈췄을 때 보여줄 프레임입니다. 편집한 내용은 저장됩니다(이후 폴더에 추가한 파일은 '폴더 순서로 되돌리기'로 반영). 애니메이션과 키 매핑 설정은 세트마다 따로 저장되어 세트를 바꾸면 함께 바뀝니다. 내장 '예시' 세트와 같은 이름으로 추가하면 예시 세트를 대체합니다." />
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- ───────── 애니메이션 ───────── -->
        <TabItem Header="애니메이션">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12">
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ProfileBannerTemplate}" Focusable="False" />

                    <GroupBox Header="프레임 전환 방식">
                        <StackPanel>
                            <RadioButton Content="고정 간격" IsChecked="{Binding IsFixedMode}" />
                            <Grid Style="{StaticResource Row}" Margin="20,2,0,8" IsEnabled="{Binding IsFixedMode}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="간격" />
                                <Slider Grid.Column="1" Minimum="16" Maximum="2000" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding FixedIntervalMs}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Style="{StaticResource RowValue}" Text="{Binding FixedIntervalMs, StringFormat={}{0} ms}" />
                            </Grid>

                            <RadioButton Content="랜덤 간격" IsChecked="{Binding IsRandomMode}" />
                            <StackPanel Margin="20,2,0,8" IsEnabled="{Binding IsRandomMode}">
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="최소" />
                                    <Slider Grid.Column="1" Minimum="16" Maximum="3000" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding RandomMinMs}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource RowValue}" Text="{Binding RandomMinMs, StringFormat={}{0} ms}" />
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="최대" />
                                    <Slider Grid.Column="1" Minimum="16" Maximum="3000" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding RandomMaxMs}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource RowValue}" Text="{Binding RandomMaxMs, StringFormat={}{0} ms}" />
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}" Text="프레임을 넘길 때마다 최소~최대 사이에서 다음 간격을 새로 뽑습니다." />
                            </StackPanel>

                            <RadioButton Content="타수 기반" IsChecked="{Binding IsKeystrokeMode}" />
                            <StackPanel Margin="20,2,0,8" IsEnabled="{Binding IsKeystrokeMode}">
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="프레임당 타수" />
                                    <Slider Grid.Column="1" Minimum="1" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding KeysPerFrame}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource RowValue}" Text="{Binding KeysPerFrame, StringFormat={}{0} 타}" />
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}" Text="키를 누를 때만 프레임이 넘어갑니다." />
                            </StackPanel>

                            <RadioButton Content="타이핑 속도 연동" IsChecked="{Binding IsAdaptiveMode}" />
                            <StackPanel Margin="20,2,0,4" IsEnabled="{Binding IsAdaptiveMode}">
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="느릴 때 간격" />
                                    <Slider Grid.Column="1" Minimum="16" Maximum="2000" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding AdaptiveSlowMs}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource RowValue}" Text="{Binding AdaptiveSlowMs, StringFormat={}{0} ms}" />
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="빠를 때 간격" />
                                    <Slider Grid.Column="1" Minimum="16" Maximum="2000" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding AdaptiveFastMs}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource RowValue}" Text="{Binding AdaptiveFastMs, StringFormat={}{0} ms}" />
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="최고 속도 기준" ToolTip="이 타이핑 속도에 도달하면 '빠를 때 간격'이 됩니다" />
                                    <Slider Grid.Column="1" Minimum="0.5" Maximum="20" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                            Value="{Binding AdaptiveTargetKeysPerSecond}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource RowValue}" Text="{Binding AdaptiveTargetKeysPerSecond, StringFormat={}{0:0.0} 타/초}" />
                                        <TextBlock Style="{StaticResource RowValue}" MinWidth="0" Foreground="#666" Text="{Binding AdaptiveTargetPerMinuteText, StringFormat=({0})}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="측정 구간" ToolTip="최근 이 시간 동안의 타수로 속도를 계산합니다" />
                                    <Slider Grid.Column="1" Minimum="250" Maximum="10000" TickFrequency="250" IsSnapToTickEnabled="True"
                                            Value="{Binding AdaptiveWindowMs}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource RowValue}" Text="{Binding AdaptiveWindowMs, StringFormat={}{0} ms}" />
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}" Text="타이핑이 빠를수록 프레임이 빨리 넘어갑니다. 속도 0이면 '느릴 때 간격', 최고 속도 기준 이상이면 '빠를 때 간격'이 됩니다." />
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="무입력 복귀 (타수 기반 · 타이핑 속도 연동)" IsEnabled="{Binding UsesIdleReturn}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="복귀까지 시간" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="10000" TickFrequency="100" IsSnapToTickEnabled="True"
                                        Value="{Binding IdleReturnMs}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Style="{StaticResource RowValue}" Text="{Binding IdleReturnMs, StringFormat={}{0} ms}" />
                            </Grid>
                            <TextBlock Style="{StaticResource Hint}" Text="입력이 이 시간 동안 없으면 첫 프레임으로 돌아갑니다. 0이면 돌아가지 않습니다(타이핑 속도 연동에서는 느린 간격으로 계속 움직입니다)." />
                        </StackPanel>
                    </GroupBox>

                    <TextBlock Style="{StaticResource Hint}"
                               Text="변경은 즉시 펫 창에 반영되므로 별도의 미리보기 없이 바로 확인할 수 있습니다." />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ───────── 효과 ───────── -->
        <TabItem Header="효과">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ProfileBannerTemplate}" Focusable="False" />
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Content="효과 추가" Style="{StaticResource BsPrimaryButton}" Command="{Binding AddEffectCommand}" Margin="0,0,12,0" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0" VerticalAlignment="Center"
                                   Text="펫 이미지에 움직임을 더합니다. 효과를 여러 개 추가하면 함께 적용되고(예: 위아래 흔들기 + 기울이기), 효과마다 강도·속도와 적용할 프레임을 고를 수 있습니다. 바꾼 내용은 펫 창에 바로 보입니다." />
                    </DockPanel>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Effects}" ItemTemplate="{StaticResource EffectItemTemplate}" />
                </ScrollViewer>

                <TextBlock Grid.Row="2" Style="{StaticResource Hint}"
                           Text="적용 프레임: '모든 프레임'이면 항상, 아니면 고른 프레임이 보이는 동안만 움직입니다(키 전용 프레임도 고를 수 있습니다). 키를 눌렀을 때만 움직이게 하려면 키 매핑 탭에서 규칙에 효과를 추가하세요." />
            </Grid>
        </TabItem>

        <!-- ───────── 키 매핑 ───────── -->
        <TabItem Header="키 매핑">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ProfileBannerTemplate}" Focusable="False" />
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Content="규칙 추가" Style="{StaticResource BsPrimaryButton}" Command="{Binding AddRuleCommand}" Margin="0,0,12,0" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0" VerticalAlignment="Center"
                                   Text="위에서부터 먼저 맞는 규칙이 적용됩니다. 키는 쉼표로 여러 개 적을 수 있고, * 는 모든 키(조합키 단독 제외)입니다. 프레임을 고르면 그 키를 누를 때 사용 중인 세트의 해당 프레임 한 장이 유지 시간 동안 표시되고, '애니메이션 재생'은 루프 애니메이션을 이어서(또는 처음부터) 재생합니다." />
                    </DockPanel>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Rules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RuleItemViewModel}">
                                <Border Style="{StaticResource ItemCard}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,6,0">
                                            <Button Content="▲" Style="{StaticResource SmallButton}" Margin="0" Padding="7,3" ToolTip="위로"
                                                    Command="{Binding Owner.MoveRuleUpCommand}" CommandParameter="{Binding}" />
                                            <Button Content="▼" Style="{StaticResource SmallButton}" Margin="3,0,0,0" Padding="7,3" ToolTip="아래로"
                                                    Command="{Binding Owner.MoveRuleDownCommand}" CommandParameter="{Binding}" />
                                        </StackPanel>

                                        <TextBox Grid.Column="1" Text="{Binding KeysText}" ToolTip="예: Enter  |  Ctrl+S, Ctrl+Shift+S  |  *" MinWidth="120" />

                                        <Button Grid.Column="2" Focusable="False"
                                                Command="{Binding Owner.CaptureKeyCommand}" CommandParameter="{Binding}"
                                                ToolTip="누른 뒤 원하는 키를 누르면 목록에 추가됩니다">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SmallButton}">
                                                    <Setter Property="Content" Value="키 캡처" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Owner.IsCapturing}" Value="True">
                                                            <Setter Property="Content" Value="키를 누르세요…" />
                                                            <Setter Property="Background" Value="#FFF3CD" />
                                                            <Setter Property="BorderBrush" Value="#FFC107" />
                                                            <Setter Property="Foreground" Value="#664D03" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <TextBlock Grid.Column="3" Text="→" VerticalAlignment="Center" Margin="8,0,4,0" />

                                        <!-- 프레임 선택: 사용 중인 세트의 '애니메이션 재생' 또는 특정 프레임 한 장만 정지 표시 -->
                                        <ComboBox Grid.Column="4" Grid.ColumnSpan="2" Width="200" Margin="0" ItemsSource="{Binding FrameChoices}" SelectedItem="{Binding SelectedFrame}"
                                                  ToolTip="루프 애니메이션을 재생할지, 사용 중인 세트의 특정 프레임 한 장만 보여줄지">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:FrameChoice}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Source="{Binding Thumbnail}" Width="20" Height="20" Margin="0,0,5,0" Stretch="Uniform" />
                                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <StackPanel Grid.Column="6" Orientation="Horizontal" Margin="10,0,0,0">
                                            <TextBox Text="{Binding HoldMs}" Width="80" TextAlignment="Right" ToolTip="유지 시간(ms). 0이면 다른 규칙이 맞을 때까지 유지" />
                                            <TextBlock Text="ms" VerticalAlignment="Center" Margin="3,0,8,0" />
                                            <CheckBox Content="처음부터" IsChecked="{Binding ResetIndex}" Margin="0" VerticalAlignment="Center"
                                                      ToolTip="키를 누를 때 애니메이션을 첫 프레임부터 다시 재생 ('애니메이션 재생'일 때만 의미 있음)" />
                                        </StackPanel>

                                        <Button Grid.Column="7" Content="삭제" Style="{StaticResource SmallDangerButton}" Margin="10,0,0,0"
                                                Command="{Binding Owner.RemoveRuleCommand}" CommandParameter="{Binding}" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="8" Style="{StaticResource ErrorText}" Text="{Binding Error}" />

                                        <!-- 이 키를 누른 동안 재생할 효과 -->
                                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="8" Margin="0,6,0,0">
                                            <ItemsControl ItemsSource="{Binding Effects}" ItemTemplate="{StaticResource EffectItemTemplate}" />
                                            <Button Content="+ 효과" Style="{StaticResource SmallButton}" HorizontalAlignment="Left" Margin="0"
                                                    Command="{Binding AddEffectCommand}"
                                                    ToolTip="이 키를 누르면 유지 시간 동안 재생할 움직임 효과를 추가합니다(여러 개면 함께 적용)" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="2">
                    <TextBlock Style="{StaticResource ErrorText}" Text="{Binding RuleErrorsText}" />
                    <TextBlock Style="{StaticResource Hint}" Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVis}}"
                               Text="키 캡처 중입니다. 아무 창에서나 키를 누르면 그 키가 규칙에 추가됩니다. 취소하려면 버튼을 다시 누르세요." />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="키 이름 예: A~Z, 0~9, F1~F24, Enter, Space, Tab, Escape, Backspace, Delete, Home, End, PageUp, PageDown, Up/Down/Left/Right, NumPad0~9, 한영, 한자, Ctrl+X, Shift+*, 0x41" />
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- ───────── 정보 ───────── -->
        <TabItem Header="정보">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Keyboard Pet" />
                    <TextBlock Text="{Binding AppVersion, StringFormat=버전 {0}}" Foreground="#6C757D" Margin="0,2,0,14" />

                    <GroupBox Header="개인정보">
                        <TextBlock Text="{Binding PrivacyNotice}" TextWrapping="Wrap" />
                    </GroupBox>

                    <GroupBox Header="설정 파일">
                        <StackPanel>
                            <TextBlock Text="{Binding SettingsFilePath}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="폴더 열기" Command="{Binding OpenSettingsFolderCommand}" />
                                <Button Content="모든 설정 기본값으로 복원" Style="{StaticResource BsDangerButton}" Command="{Binding RestoreDefaultsCommand}" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding LoadError}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding StatusMessage}" />
                            <TextBlock Style="{StaticResource Hint}" Text="변경은 즉시 적용되며 0.5초 뒤 자동 저장됩니다. 이전 파일은 settings.json.bak으로 보관됩니다." />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="알려진 제한">
                        <TextBlock TextWrapping="Wrap"
                                   Text="• 관리자 권한으로 실행 중인 다른 프로그램에 입력할 때는 Windows 보안 정책(UIPI) 때문에 키 입력을 받을 수 없습니다.&#10;• 독점 전체화면 게임 위에는 창이 표시되지 않습니다. 게임을 '테두리 없는 창' 모드로 설정하세요." />
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
