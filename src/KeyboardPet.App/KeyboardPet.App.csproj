<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>KeyboardPet</AssemblyName>
    <RootNamespace>KeyboardPet.App</RootNamespace>

    <Version>1.7.1</Version>
    <Product>Keyboard Pet</Product>
    <AssemblyTitle>Keyboard Pet</AssemblyTitle>
    <Description>키보드 입력에 반응하는 데스크톱 펫 애니메이션</Description>
    <Copyright>Copyright © 2026</Copyright>
    <NeutralLanguage>ko-KR</NeutralLanguage>

    <!-- 배포 옵션은 scripts\publish.ps1 또는 Properties\PublishProfiles\win-x64-single.pubxml 참고 -->
    <SatelliteResourceLanguages>ko</SatelliteResourceLanguages>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- 대부분 유휴 상태인 트레이 앱: 백그라운드 GC 스레드·PGO 계측·EventSource 초기화를 끈다(스레드 1개, 메모리 수 MB 절약) -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- 등록 16개짜리 컨테이너에 Reflection.Emit 동적 엔진은 이득이 없다(어셈블리 로드·IL 생성만 늘어남) -->
    <RuntimeHostConfigurationOption Include="Microsoft.Extensions.DependencyInjection.DisableDynamicEngine" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KeyboardPet.Core\KeyboardPet.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\**\*.png" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
