<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Bootstrap 5 스타일 테마.
        색상·모서리(6px)·간격·포커스 링·드롭다운 모양을 Bootstrap 규칙에 맞춰 WPF 기본 컨트롤에 입힌다.
        App.xaml에서 병합되어 설정 창, 트레이/펫 컨텍스트 메뉴, 툴팁 등 앱 전체에 적용된다.
    -->

    <!-- ───────── 색상 토큰 ───────── -->
    <Color x:Key="BsPrimaryColor">#0D6EFD</Color>
    <SolidColorBrush x:Key="BsPrimary" Color="#0D6EFD" />
    <SolidColorBrush x:Key="BsPrimaryHover" Color="#0B5ED7" />
    <SolidColorBrush x:Key="BsPrimaryActive" Color="#0A58CA" />
    <SolidColorBrush x:Key="BsPrimarySubtle" Color="#CFE2FF" />
    <SolidColorBrush x:Key="BsSecondary" Color="#6C757D" />
    <SolidColorBrush x:Key="BsSecondaryHover" Color="#5C636A" />
    <SolidColorBrush x:Key="BsDanger" Color="#DC3545" />
    <SolidColorBrush x:Key="BsDangerHover" Color="#BB2D3B" />
    <SolidColorBrush x:Key="BsBody" Color="#212529" />
    <SolidColorBrush x:Key="BsMuted" Color="#6C757D" />
    <SolidColorBrush x:Key="BsDisabled" Color="#ADB5BD" />
    <SolidColorBrush x:Key="BsBorder" Color="#DEE2E6" />
    <SolidColorBrush x:Key="BsInputBorder" Color="#CED4DA" />
    <SolidColorBrush x:Key="BsFocusBorder" Color="#86B7FE" />
    <SolidColorBrush x:Key="BsFocusRing" Color="#400D6EFD" />
    <SolidColorBrush x:Key="BsLight" Color="#F8F9FA" />
    <SolidColorBrush x:Key="BsLightHover" Color="#E9ECEF" />
    <SolidColorBrush x:Key="BsWhite" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BsMenuBorder" Color="#D3D6DA" />
    <SolidColorBrush x:Key="BsTrack" Color="#DEE2E6" />

    <CornerRadius x:Key="BsRadius">6</CornerRadius>
    <CornerRadius x:Key="BsRadiusLg">8</CornerRadius>

    <FontFamily x:Key="BsFont">Segoe UI, Malgun Gothic, sans-serif</FontFamily>

    <!-- ───────── 공통 텍스트 ───────── -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BsBody}" />
        <Setter Property="FontFamily" Value="{StaticResource BsFont}" />
    </Style>

    <Style x:Key="BsMutedText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource BsMuted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ───────── 버튼 ───────── -->
    <Style x:Key="BsButtonBase" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource BsFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource BsRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="0" ShadowDepth="0" Color="#0D6EFD" Opacity="0.35" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.65" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 기본 버튼 = btn-outline-secondary -->
    <Style TargetType="Button" BasedOn="{StaticResource BsButtonBase}">
        <Setter Property="Background" Value="{StaticResource BsWhite}" />
        <Setter Property="BorderBrush" Value="{StaticResource BsSecondary}" />
        <Setter Property="Foreground" Value="{StaticResource BsSecondary}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BsSecondary}" />
                <Setter Property="Foreground" Value="{StaticResource BsWhite}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource BsSecondaryHover}" />
                <Setter Property="BorderBrush" Value="{StaticResource BsSecondaryHover}" />
                <Setter Property="Foreground" Value="{StaticResource BsWhite}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- btn-primary -->
    <Style x:Key="BsPrimaryButton" TargetType="Button" BasedOn="{StaticResource BsButtonBase}">
        <Setter Property="Background" Value="{StaticResource BsPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BsPrimary}" />
        <Setter Property="Foreground" Value="{StaticResource BsWhite}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BsPrimaryHover}" />
                <Setter Property="BorderBrush" Value="{StaticResource BsPrimaryHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource BsPrimaryActive}" />
                <Setter Property="BorderBrush" Value="{StaticResource BsPrimaryActive}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- btn-outline-danger -->
    <Style x:Key="BsDangerButton" TargetType="Button" BasedOn="{StaticResource BsButtonBase}">
        <Setter Property="Background" Value="{StaticResource BsWhite}" />
        <Setter Property="BorderBrush" Value="{StaticResource BsDanger}" />
        <Setter Property="Foreground" Value="{StaticResource BsDanger}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BsDanger}" />
                <Setter Property="Foreground" Value="{StaticResource BsWhite}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource BsDangerHover}" />
                <Setter Property="BorderBrush" Value="{StaticResource BsDangerHover}" />
                <Setter Property="Foreground" Value="{StaticResource BsWhite}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- btn-sm 변형 -->
    <Style x:Key="BsSmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="BsSmallDangerButton" TargetType="Button" BasedOn="{StaticResource BsDangerButton}">
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="BsSmallPrimaryButton" TargetType="Button" BasedOn="{StaticResource BsPrimaryButton}">
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- btn-close 느낌의 아주 작은 × 버튼 (프레임 타일) -->
    <Style x:Key="BsCloseButton" TargetType="Button" BasedOn="{StaticResource BsButtonBase}">
        <Setter Property="Background" Value="{StaticResource BsWhite}" />
        <Setter Property="BorderBrush" Value="{StaticResource BsBorder}" />
        <Setter Property="Foreground" Value="{StaticResource BsMuted}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="FontSize" Value="11" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BsDanger}" />
                <Setter Property="BorderBrush" Value="{StaticResource BsDanger}" />
                <Setter Property="Foreground" Value="{StaticResource BsWhite}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ───────── 텍스트 입력 (form-control) ───────── -->
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource BsFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource BsBody}" />
        <Setter Property="Background" Value="{StaticResource BsWhite}" />
        <Setter Property="BorderBrush" Value="{StaticResource BsInputBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{StaticResource BsBody}" />
        <Setter Property="SelectionBrush" Value="{StaticResource BsPrimarySubtle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource BsRadius}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BsDisabled}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BsFocusBorder}" />
                            <Setter TargetName="Bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#0D6EFD" Opacity="0.35" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BsDanger}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BsLightHover}" />
                            <Setter Property="Foreground" Value="{StaticResource BsMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ───────── 콤보박스 (form-select + dropdown-menu) ───────── -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource BsFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource BsBody}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BsLightHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BsPrimary}" />
                            <Setter Property="Foreground" Value="{StaticResource BsWhite}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource BsFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource BsBody}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="{StaticResource BsWhite}"
                                            BorderBrush="{StaticResource BsInputBorder}" BorderThickness="1"
                                            CornerRadius="{StaticResource BsRadius}" SnapsToDevicePixels="True">
                                        <Path Data="M0,0 L5,5 L10,0" Stroke="#343A40" StrokeThickness="1.6"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,1,11,0" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BsDisabled}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BsFocusBorder}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter x:Name="Selected" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="11,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left" />

                        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="3"
                               IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Fade" StaysOpen="False">
                            <Border x:Name="DropDown" MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{StaticResource BsWhite}" BorderBrush="{StaticResource BsMenuBorder}"
                                    BorderThickness="1" CornerRadius="{StaticResource BsRadius}" Padding="0,5"
                                    Margin="0,0,10,10" SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.18" />
                                </Border.Effect>
                                <ScrollViewer SnapsToDevicePixels="True" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.65" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ───────── 체크박스 / 라디오 (form-check) ───────── -->
    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource BsFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource BsBody}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent" VerticalAlignment="Center">
                        <Border x:Name="Box" Width="17" Height="17" CornerRadius="4"
                                BorderBrush="{StaticResource BsDisabled}" BorderThickness="1"
                                Background="{StaticResource BsWhite}" VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <Path x:Name="Check" Data="M3,7.5 L6.5,11 L12,4.5" Stroke="{StaticResource BsWhite}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter x:Name="Content" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Content" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BsFocusBorder}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource BsPrimary}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BsPrimary}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource BsFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource BsBody}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent" VerticalAlignment="Center">
                        <Grid Width="17" Height="17" VerticalAlignment="Center">
                            <Ellipse x:Name="Outer" Stroke="{StaticResource BsDisabled}" StrokeThickness="1" Fill="{StaticResource BsWhite}" />
                            <Ellipse x:Name="Inner" Width="7" Height="7" Fill="{StaticResource BsWhite}" Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Outer" Property="Stroke" Value="{StaticResource BsFocusBorder}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Outer" Property="Fill" Value="{StaticResource BsPrimary}" />
                            <Setter TargetName="Outer" Property="Stroke" Value="{StaticResource BsPrimary}" />
                            <Setter TargetName="Inner" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ───────── 슬라이더 (form-range) ───────── -->
    <Style x:Key="BsSliderFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="6" Background="{StaticResource BsPrimary}" CornerRadius="3,0,0,3" VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BsSliderRest" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="6" Background="Transparent" VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center" Background="Transparent">
                        <Border Height="6" CornerRadius="3" Background="{StaticResource BsTrack}" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource BsSliderFill}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource BsSliderRest}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="18" Height="18" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse x:Name="Knob" Fill="{StaticResource BsPrimary}" Stroke="{StaticResource BsWhite}" StrokeThickness="2" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Knob" Property="Fill" Value="{StaticResource BsPrimaryHover}" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Knob" Property="Fill" Value="{StaticResource BsPrimaryActive}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ───────── 탭 (nav-tabs) ───────── -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{StaticResource BsWhite}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" BorderBrush="{StaticResource BsBorder}" BorderThickness="0,0,0,1" Margin="0,0,0,-1" Panel.ZIndex="0">
                            <TabPanel IsItemsHost="True" Margin="0" />
                        </Border>
                        <Border Grid.Row="1" Background="{StaticResource BsWhite}" BorderBrush="{StaticResource BsBorder}"
                                BorderThickness="0,1,0,0" Panel.ZIndex="0">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="FontFamily" Value="{StaticResource BsFont}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{StaticResource BsPrimary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1,1,1,0"
                            CornerRadius="6,6,0,0" Padding="16,8" Margin="0,0,2,0" SnapsToDevicePixels="True">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BsLightHover}" />
                            <Setter Property="Foreground" Value="{StaticResource BsPrimaryHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BsWhite}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BsBorder}" />
                            <Setter TargetName="Bd" Property="Margin" Value="0,0,2,-1" />
                            <Setter Property="Foreground" Value="#495057" />
                            <Setter Property="Panel.ZIndex" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ───────── 카드 (GroupBox → card) ───────── -->
    <Style TargetType="GroupBox">
        <Setter Property="Margin" Value="0,0,0,14" />
        <Setter Property="Foreground" Value="{StaticResource BsBody}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border Background="{StaticResource BsWhite}" BorderBrush="{StaticResource BsBorder}" BorderThickness="1"
                            CornerRadius="{StaticResource BsRadiusLg}" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{StaticResource BsLight}" BorderBrush="{StaticResource BsBorder}"
                                    BorderThickness="0,0,0,1" CornerRadius="8,8,0,0" Padding="14,8">
                                <ContentPresenter ContentSource="Header" TextElement.FontWeight="SemiBold" TextElement.FontSize="13" />
                            </Border>
                            <ContentPresenter Grid.Row="1" Margin="14,12,14,12" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ───────── 컨텍스트 메뉴 (dropdown-menu) ───────── -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FontFamily" Value="{StaticResource BsFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{StaticResource BsWhite}" BorderBrush="{StaticResource BsMenuBorder}" BorderThickness="1"
                            CornerRadius="{StaticResource BsRadius}" Padding="0,6" Margin="0,0,12,12" MinWidth="200" SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="4" Direction="270" Opacity="0.18" />
                        </Border.Effect>
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{StaticResource BsBorder}" Margin="0,6" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="FontFamily" Value="{StaticResource BsFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource BsBody}" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="Bd" Background="Transparent" Padding="14,7" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path x:Name="Check" Grid.Column="0" Data="M1,5 L4.5,8.5 L11,1.5" Stroke="{StaticResource BsPrimary}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Hidden" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                                <Path x:Name="Arrow" Grid.Column="2" Data="M0,0 L5,5 L0,10" Stroke="{StaticResource BsMuted}" StrokeThickness="1.6"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Margin="18,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="0" VerticalOffset="-7"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{StaticResource BsWhite}" BorderBrush="{StaticResource BsMenuBorder}" BorderThickness="1"
                                    CornerRadius="{StaticResource BsRadius}" Padding="0,6" Margin="0,0,12,12" MinWidth="180" SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="4" Direction="270" Opacity="0.18" />
                                </Border.Effect>
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BsLightHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource BsDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ───────── 툴팁 ───────── -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#E6000000" />
        <Setter Property="Foreground" Value="{StaticResource BsWhite}" />
        <Setter Property="FontFamily" Value="{StaticResource BsFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource BsRadius}"
                            Padding="{TemplateBinding Padding}" MaxWidth="320">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="Foreground" Value="{StaticResource BsWhite}" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ───────── 스크롤바 (얇은 형태) ───────── -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent" Margin="2,0,0,0">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource BsSliderRest}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource BsSliderRest}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Bar" Background="#C4C8CC" CornerRadius="4" Width="8" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bar" Property="Background" Value="#9AA0A6" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent" Margin="0,2,0,0">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource BsSliderRest}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource BsSliderRest}" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="#C4C8CC" CornerRadius="4" Height="8" />
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
